---
// The mockup's footer: "© 2026 Of Tomorrow, Inc." then the sister sites and Privacy.
// The year is the build year, so it reads 2026 now and does not go stale.
const year = new Date().getFullYear();
const links = [
	{ href: 'https://byo-llm.com', label: 'byo-llm.com' },
	{ href: 'https://byollm.cloud', label: 'byollm.cloud' },
	{ href: 'https://todd.oftomorrow.net', label: 'todd.oftomorrow.net' },
	{ href: '/privacy-policy', label: 'Privacy' },
];
---

<footer class="mx-auto max-w-magazine px-6">
	<div class="border-t-[6px] border-ink py-8">
		<div
			class="flex flex-col gap-4 text-[15px] text-body-muted sm:flex-row sm:items-baseline sm:justify-between"
		>
			<p class="m-0" data-testid="footer-copyright">© {year} Of Tomorrow, Inc.</p>
			<ul class="label m-0 flex list-none flex-wrap gap-x-5 gap-y-1 p-0 text-[13px]" data-testid="footer-links">
				{
					links.map(({ href, label }) => (
						<li>
							<a href={href} class="text-body-muted hover:text-ink">
								{label}
							</a>
						</li>
					))
				}
				<li>
					<!-- Not in the mockup: kept so a visitor can reopen the consent choices. -->
					<button
						type="button"
						onclick="window.dispatchEvent(new CustomEvent('openCookieSettings'))"
						class="label cursor-pointer border-0 bg-transparent p-0 text-[13px] text-body-muted hover:text-ink"
					>
						Cookie settings
					</button>
				</li>
			</ul>
		</div>
	</div>
</footer>
