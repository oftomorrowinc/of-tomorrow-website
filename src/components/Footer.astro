---
const year = new Date().getFullYear();
---

<footer class="mx-auto max-w-magazine px-6">
	<div class="border-t-[6px] border-ink py-8">
		<div
			class="flex flex-col gap-4 text-[15px] text-body-muted sm:flex-row sm:items-baseline sm:justify-between"
		>
			<p class="m-0">
				<span class="label text-ink">Of Tomorrow, Inc.</span> · © {year} · Building the world of
				tomorrow, in public.
			</p>
			<ul class="label m-0 flex list-none flex-wrap gap-x-5 gap-y-1 p-0 text-[13px]">
				<li><a href="/blog" class="text-body-muted hover:text-ink">Blog</a></li>
				<li><a href="/privacy-policy" class="text-body-muted hover:text-ink">Privacy</a></li>
				<li><a href="/cookie-policy" class="text-body-muted hover:text-ink">Cookies</a></li>
				<li>
					<button
						type="button"
						onclick="window.dispatchEvent(new CustomEvent('openCookieSettings'))"
						class="label cursor-pointer border-0 bg-transparent p-0 text-[13px] text-body-muted hover:text-ink"
					>
						Cookie settings
					</button>
				</li>
			</ul>
		</div>
	</div>
</footer>
