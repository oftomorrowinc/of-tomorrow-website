---
// The monogram tile (specs/news_001.md §4): the OT mark on paper with the
// project's accent, shown wherever a story has no picture, so the strip never
// has a hole in it. One drawing, five variants: the accent is the project's
// magazine token (ACCENT in src/lib/today.ts), never a colour of its own.
import { ACCENT, type Project } from '../../lib/today';

interface Props {
	project: Project;
	size?: number;
	class?: string;
}

const { project, size = 120, class: className = '' } = Astro.props;
const accent = ACCENT[project];
// The letters are ink on the light accent, paper-light on the dark ones.
const letters = accent === 'mustard' ? 'ink' : 'paper-light';
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 480 480"
	width={size}
	height={size}
	role="img"
	aria-label="Of Tomorrow"
	class={`block shrink-0 ${className}`}
	data-testid="monogram"
	data-project={project}
	data-accent={accent}
>
	<rect width="480" height="480" style="fill: var(--paper)" />
	<circle cx="240" cy="240" r="176" style={`fill: var(--${accent})`} data-part="disc" />
	<!-- O -->
	<circle cx="190" cy="252" r="78" fill="none" stroke-width="32" style={`stroke: var(--${letters})`} data-part="o" />
	<!-- T: the bar crosses into the O, the stem stands beside it -->
	<rect x="214" y="150" width="156" height="32" style={`fill: var(--${letters})`} data-part="t" />
	<rect x="276" y="150" width="32" height="184" style={`fill: var(--${letters})`} data-part="t" />
	<!-- 2 px at the strip's 120 px -->
	<rect x="4" y="4" width="472" height="472" fill="none" stroke-width="8" style="stroke: var(--ink)" />
</svg>
