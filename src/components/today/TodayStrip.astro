---
// The homepage strip (specs/news_001.md §6): the dateline, then the newest
// stories as cards on paper with a hairline between them, three across on a
// desktop and one on a phone. It moves on its own, one card every eight
// seconds (ADVANCE_MS), and wraps to the newest at the end; it pauses while a
// pointer is over it or focus is in it, and stops for good on any touch.
// Arrows for the reader. prefers-reduced-motion: no advance and no scrolling,
// the cards that fit sit still and a "more" link takes the reader to /today.
// Static: the cards are in the build, nothing is fetched.
import { getCollection } from 'astro:content';
import StoryCard from './StoryCard.astro';
import { longDay, newestFirst, today } from '../../lib/today';

interface Props {
	/** How many of the newest the strip carries; the rest are on /today. */
	count?: number;
}

const { count = 15 } = Astro.props;
const stories = newestFirst(await getCollection('today')).slice(0, count);
// Frame copy (§5.5): pending Todd's okay, see README.md.
const dateline = `Today at Of Tomorrow · ${longDay(today())}`;
---

{
	stories.length > 0 && (
		<section id="today" class="border-b-2 border-ink py-8" data-testid="today-strip" data-today-frame data-today-state="playing" aria-roledescription="carousel">
			<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-ink pb-3">
				<h2 class="label m-0 text-[18px] !tracking-[0.12em] text-ink" data-testid="today-dateline">
					{dateline}
				</h2>
				<div class="flex items-center gap-4">
					<button type="button" class="today-arrow" data-today-prev aria-label="Previous">←</button>
					<button type="button" class="today-arrow" data-today-next aria-label="Next">→</button>
					<a href="/today" class="label text-[14px] text-teal hover:text-ink" data-testid="all-stories">All stories →</a>
				</div>
			</div>
			<ol class="today-track m-0 list-none p-0" data-today-track aria-live="off">
				{stories.map((story) => (
					<li class="today-cell" data-testid="strip-card">
						<StoryCard story={story} as="strip" />
					</li>
				))}
			</ol>
			<p class="today-more label m-0 mt-4 text-[14px]" data-today-more>
				<a href="/today" class="text-teal hover:text-ink">More stories →</a>
			</p>
		</section>
	)
}

<style>
	.today-track {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: 100%;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		scroll-behavior: smooth;
	}
	.today-track::-webkit-scrollbar {
		display: none;
	}
	@media (min-width: 768px) {
		.today-track {
			grid-auto-columns: 50%;
		}
	}
	@media (min-width: 1024px) {
		.today-track {
			grid-auto-columns: calc(100% / 3);
		}
	}
	.today-cell {
		scroll-snap-align: start;
		padding: 20px 20px 4px;
		border-left: 1px solid var(--ink);
	}
	.today-cell:first-child {
		padding-left: 0;
		border-left: 0;
	}
	.today-arrow {
		width: 36px;
		height: 36px;
		border: 2px solid var(--ink);
		background: transparent;
		color: var(--ink);
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 18px;
		line-height: 1;
		cursor: pointer;
	}
	.today-arrow:hover {
		background: var(--ink);
		color: var(--paper);
	}
	.today-arrow:focus-visible,
	.today-cell :global(a:focus-visible) {
		outline: 2px solid var(--poppy);
		outline-offset: 3px;
	}
	.today-more {
		display: none;
	}
	/* Reduced motion: the cards that fit, still; no arrows; "more" instead. */
	@media (prefers-reduced-motion: reduce) {
		.today-track {
			overflow-x: hidden;
			scroll-behavior: auto;
		}
		.today-arrow {
			display: none;
		}
		.today-more {
			display: block;
		}
	}
	.today-arrow:disabled {
		opacity: 0.35;
		cursor: default;
		background: transparent;
		color: var(--ink);
	}
</style>

<script>
	// §6: one card every eight seconds, wrapping to the newest; paused while a
	// pointer is over the strip or focus is in it, stopped for good by a touch.
	// The arrows move one card and restart the clock. Reduced motion: nothing moves.
	const ADVANCE_MS = 8000;
	const still = window.matchMedia('(prefers-reduced-motion: reduce)');
	document.querySelectorAll<HTMLElement>('#today').forEach((strip) => {
		const track = strip.querySelector<HTMLElement>('[data-today-track]');
		const prev = strip.querySelector<HTMLButtonElement>('[data-today-prev]');
		const next = strip.querySelector<HTMLButtonElement>('[data-today-next]');
		if (!track || !prev || !next) return;
		const step = () => track.querySelector<HTMLElement>('.today-cell')?.offsetWidth ?? track.clientWidth;
		const atEnd = () => track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
		const sync = () => {
			prev.disabled = track.scrollLeft <= 1;
			next.disabled = atEnd();
		};
		const go = (dx: number) => track.scrollBy({ left: dx, behavior: still.matches ? 'instant' : 'smooth' });

		let hovered = false;
		let focused = false;
		let touched = false;
		let timer: number | undefined;
		const state = () => (still.matches ? 'static' : touched ? 'stopped' : hovered || focused || document.hidden ? 'paused' : 'playing');
		const arm = () => {
			window.clearTimeout(timer);
			timer = undefined;
			const s = state();
			strip.dataset.todayState = s;
			if (s === 'playing') timer = window.setTimeout(advance, ADVANCE_MS);
		};
		const advance = () => {
			if (atEnd()) track.scrollTo({ left: 0, behavior: 'smooth' });
			else go(step());
			arm();
		};

		prev.addEventListener('click', () => {
			go(-step());
			arm();
		});
		next.addEventListener('click', () => {
			go(step());
			arm();
		});
		strip.addEventListener('pointerenter', (e) => {
			if (e.pointerType === 'mouse') (hovered = true), arm();
		});
		strip.addEventListener('pointerleave', (e) => {
			if (e.pointerType === 'mouse') (hovered = false), arm();
		});
		const touch = () => {
			touched = true;
			arm();
		};
		strip.addEventListener('touchstart', touch, { passive: true });
		strip.addEventListener('pointerdown', (e) => e.pointerType !== 'mouse' && touch());
		strip.addEventListener('focusin', () => ((focused = true), arm()));
		strip.addEventListener('focusout', (e) => {
			if (!strip.contains(e.relatedTarget as Node | null)) (focused = false), arm();
		});
		document.addEventListener('visibilitychange', arm);
		still.addEventListener('change', () => {
			if (still.matches) track.scrollTo({ left: 0, behavior: 'instant' });
			arm();
		});
		track.addEventListener('scroll', sync, { passive: true });
		window.addEventListener('resize', sync);
		sync();
		arm();
	});
</script>
