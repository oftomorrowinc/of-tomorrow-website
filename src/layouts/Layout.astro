---
import TrackingScripts from '../components/TrackingScripts.astro';
import { ConsentManager } from '../components/ConsentManager';
import Fonts from '../components/Fonts.astro';
import '../styles/magazine.css';

export interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const {
  title,
  description = "Of Tomorrow, Inc. - Engineering tomorrow's possibilities for everyone, everywhere",
  bodyClass = 'bg-bg-primary text-text-primary min-h-screen font-body',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <Fonts />
    <title>{title}</title>
    
    <!-- GDPR-Compliant Tracking Scripts -->
    <TrackingScripts />
  </head>
  <body class={bodyClass}>
    <slot />
    
    <!-- GDPR Consent Management -->
    <ConsentManager client:load />
    
    <!-- TawkTo Chat Widget -->
    <script type="text/javascript">
    var Tawk_API=Tawk_API||{}, Tawk_LoadStart=new Date();
    (function(){
    var s1=document.createElement("script"),s0=document.getElementsByTagName("script")[0];
    s1.async=true;
    s1.src='https://embed.tawk.to/68a37d666dc7731924f6f400/1j2va3mc3';
    s1.charset='UTF-8';
    s1.setAttribute('crossorigin','*');
    s0.parentNode.insertBefore(s1,s0);
    })();
    </script>
  </body>
</html>