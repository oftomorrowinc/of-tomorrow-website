---
import Layout from '../layouts/Layout.astro';

const swatches = [
  ['paper', 'bg-paper'],
  ['paper-light', 'bg-paper-light'],
  ['paper-dark', 'bg-paper-dark'],
  ['ink', 'bg-ink'],
  ['poppy', 'bg-poppy'],
  ['teal', 'bg-teal'],
  ['mustard', 'bg-mustard'],
  ['body-muted', 'bg-body-muted'],
  ['caption', 'bg-caption'],
];
---

<Layout title="Brand Test - Of Tomorrow, Inc." bodyClass="magazine min-h-screen">
  <main class="mx-auto max-w-magazine px-6 py-12">
    <h1 class="m-0 font-display text-[72px] font-black uppercase leading-none">Of Tomorrow <span class="text-poppy">Inc.</span></h1>
    <p class="label text-teal">Brand configuration test — docs/design/README.md</p>

    <h2 class="font-display text-[40px] font-black uppercase">Colours</h2>
    <ul class="m-0 grid list-none grid-cols-3 gap-6 p-0">
      {swatches.map(([name, cls]) => (
        <li class="border-2 border-ink"><div class={`h-16 ${cls}`}></div><p class="label m-0 p-2 text-[13px]">{name}</p></li>
      ))}
    </ul>

    <h2 class="font-display text-[40px] font-black uppercase">Type</h2>
    <p class="font-display text-[28px] font-black uppercase">Big Shoulders Display — nameplates, headlines, labels</p>
    <p class="text-[20px]">Source Serif 4 — the reading face, <em>with its italic</em>.</p>

    <div class="flex flex-wrap gap-4">
      <button class="label h-12 border-2 border-poppy bg-poppy px-6 text-paper-light">Primary Action</button>
      <button class="label h-12 border-2 border-ink bg-transparent px-6 text-ink">Secondary Action</button>
    </div>
  </main>
</Layout>
