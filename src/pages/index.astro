---
import Layout from '../layouts/Layout.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import { CONTACT_EMAIL } from '../consts';
import { latestWorkshopPosts, WORKSHOP_URL } from '../lib/workshop';

// The copy is the mockup's, word for word (docs/design/README.md, "The copy").
const building = [
	{
		n: '01',
		name: 'BYOLLM',
		copy: 'Bring Your Own LLM. Use your own AI on websites you authorize – your models, your subscriptions, a small program on your machine. Open source, MIT.',
		href: 'https://byo-llm.com',
		cta: 'Open source · 0.1.2',
		destination: 'byo-llm.com',
	},
	{
		n: '02',
		name: 'BYOLLM Cloud',
		copy: 'The same protocol, hosted: a dashboard for the sites you use, and early access while we open the doors a few people at a time.',
		href: 'https://byollm.cloud/early-access',
		cta: 'Early access',
		destination: 'byollm.cloud',
	},
	{
		n: '03',
		name: 'Translations Of Tomorrow',
		copy: 'Chapter-by-chapter book translation that keeps the context and the culture – built for independent authors, run on their own AI.',
		href: 'https://translations.oftomorrow.net',
		cta: 'Visit the site',
		destination: 'translations.oftomorrow.net',
	},
];

const posts = await latestWorkshopPosts(2);
const dateFormat = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const button =
	'label inline-flex h-12 w-full items-center justify-center border-2 px-6 text-[15px] tracking-[0.08em] no-underline sm:w-auto';
---

<Layout
	title="Of Tomorrow, Inc. — Building the world of tomorrow, in public"
	description="A great big beautiful tomorrow doesn't arrive in your feed. We have to build it. So let's get to work."
	bodyClass="magazine min-h-screen"
>
	<Masthead />

	<main>
	<div class="mx-auto max-w-magazine px-6">
		<!-- The cover story -->
		<section id="cover" class="grid grid-cols-1 gap-8 border-b-2 border-ink py-10 lg:grid-cols-12 lg:py-14">
			<div class="flex flex-col justify-center lg:col-span-7">
				<p class="label m-0 mb-4 text-[15px] text-teal">The cover story</p>
				<h1
					class="m-0 font-display text-[52px] font-black uppercase leading-[0.92] text-ink sm:text-[68px] lg:text-[84px]"
				>
					A great big beautiful tomorrow doesn't arrive in your feed.
				</h1>
				<p class="mb-0 mt-6 max-w-[40ch] text-[20px] leading-[1.55] text-body-muted sm:text-[22px]" data-testid="deck">
					We have to build it. Small, single-purpose tools, well connected, running on the compute you already own – open source where it counts, and shown to you while it's being made.
				</p>
				<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
					<a
						href="https://byo-llm.com"
						target="_blank"
						rel="noopener noreferrer"
						class={`${button} border-poppy bg-poppy text-paper-light hover:bg-ink hover:border-ink`}
						data-track-type="hero-cta"
						data-track-destination="byo-llm.com"
						data-track-location="cover-story"
						id="byollm-hero-cta"
					>
						See BYOLLM →
					</a>
					<a
						href="https://byollm.cloud/early-access"
						target="_blank"
						rel="noopener noreferrer"
						class={`${button} border-ink bg-transparent text-ink hover:bg-ink hover:text-paper`}
						data-track-type="hero-cta-secondary"
						data-track-destination="byollm.cloud"
						data-track-location="cover-story"
						id="byollm-hero-cta-cloud"
					>
						Early access to the cloud
					</a>
				</div>
			</div>
			<figure class="m-0 lg:col-span-5" data-testid="fig-1">
				<img
					src="/images/art/cover-workbench.webp"
					width="1024"
					height="1536"
					alt="A painted magazine-cover scene: two hands adjust a dial on an open toaster-sized machine of valves and wires at a workbench, a city of towers, a monorail and an airship through the window."
					class="block h-auto w-full border-2 border-ink bg-paper-dark"
					fetchpriority="high"
				/>
				<figcaption class="label mt-2 text-[13px] text-teal">
					Fig. 1 — A machine the size of a toaster, and the town it talks to.
				</figcaption>
			</figure>
		</section>
	</div>

	<!-- NOW BUILDING, on ink -->
	<section id="now-building" class="bg-ink text-paper">
		<div class="mx-auto max-w-magazine px-6 py-12 lg:py-16">
			<div class="mb-8 flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
				<h2 class="m-0 font-display text-[40px] font-black uppercase leading-none">Now building</h2>
				<p class="label m-0 text-[14px] text-mustard" data-testid="building-tag">Three things, all real</p>
			</div>
			<ol class="m-0 grid list-none grid-cols-1 gap-8 p-0 md:grid-cols-3">
				{
					building.map(({ n, name, copy, href, cta, destination }) => (
						<li class="flex flex-col border-2 border-paper p-6" data-testid="building-card">
							<span class="font-display text-[64px] font-black leading-none text-mustard" aria-hidden="true">
								{n}
							</span>
							<h3 class="m-0 mt-3 font-display text-[28px] font-black uppercase leading-none">{name}</h3>
							<p class="mb-6 mt-3 flex-1 text-[18px] leading-[1.5] text-paper">{copy}</p>
							<a
								href={href}
								target="_blank"
								rel="noopener noreferrer"
								class="label text-[14px] text-mustard hover:text-paper"
								data-track-type="external-link"
								data-track-destination={destination}
								data-track-location="now-building"
							>
								{cta} →
							</a>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<div class="mx-auto max-w-magazine px-6">
		<!-- FROM THE WORKSHOP: todd.oftomorrow.net's newest two, read at build time -->
		<section id="workshop" class="border-b-2 border-ink py-12 lg:py-16">
			<div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
				<h2 class="m-0 font-display text-[40px] font-black uppercase leading-none">From the workshop</h2>
				<a href={WORKSHOP_URL} class="label text-[14px] text-teal hover:text-ink" data-testid="all-posts">
					All posts →
				</a>
			</div>
			<p class="mb-8 mt-0 max-w-[60ch] text-[20px] leading-[1.55] text-body-muted" data-testid="workshop-intro">
				What's being built, written down as it happens – real dates, including the parts that don't work.
				Todd's posts live at <a href={WORKSHOP_URL} class="text-teal hover:text-ink">todd.oftomorrow.net</a>.
			</p>
			<ul class="m-0 grid list-none grid-cols-1 gap-8 p-0 md:grid-cols-2">
				{
					posts.map((post) => (
						<li class="flex flex-col border-2 border-ink bg-paper-light p-6" data-testid="workshop-card">
							<p class="label m-0 text-[13px] text-teal">
								todd.oftomorrow.net
								{post.pubDate && <> · <time datetime={post.pubDate.toISOString()}>{dateFormat.format(post.pubDate)}</time></>}
							</p>
							<h3 class="m-0 mt-3 font-display text-[30px] font-black uppercase leading-[0.95]">
								<a href={post.link} class="text-ink no-underline hover:text-poppy">
									{post.title}
								</a>
							</h3>
							<p class="mb-0 mt-3 text-[18px] leading-[1.55] text-body-muted">{post.description}</p>
						</li>
					))
				}
			</ul>
		</section>

		<!-- THE COMPANY -->
		<section id="company" class="grid grid-cols-1 gap-8 py-12 lg:grid-cols-12 lg:py-16">
			<div class="lg:col-span-6">
				<h2 class="m-0 mb-6 font-display text-[40px] font-black uppercase leading-none">The company</h2>
				<p class="mb-5 mt-0 text-[20px] leading-[1.55]">
					Of Tomorrow, Inc. stands at the intersection of imagination and innovation, where the bright optimism
					of Popular Science and Popular Mechanics' golden era meets today's technological possibilities.
				</p>
				<p class="m-0 text-[20px] leading-[1.55] text-body-muted">
					We believe technology's greatest promise lies not in replacing human potential, but in amplifying it
					for everyone, everywhere. Our work embodies the spirit of the golden age magazines, when the future
					felt limitless and every innovation promised universal progress and a "great big beautiful tomorrow."
				</p>
				<div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
					<div class="border-2 border-ink bg-paper-light p-5" id="mission-card">
						<h3 class="label m-0 mb-2 text-[15px] text-teal">Our mission</h3>
						<p class="m-0 text-[18px] leading-[1.5]">
							Engineer tomorrow's possibilities into today's reality through inclusive technology and media that serves all people.
						</p>
					</div>
					<div class="border-2 border-ink bg-paper-light p-5" id="vision-card">
						<h3 class="label m-0 mb-2 text-[15px] text-teal">Our vision</h3>
						<p class="m-0 text-[18px] leading-[1.5]">
							An inclusive tomorrow where technology amplifies human creativity and makes ambitious possibilities achievable for everyone, everywhere.
						</p>
					</div>
				</div>
			</div>
			<figure class="m-0 lg:col-span-6 lg:self-center" data-testid="fig-2">
				<img
					src="/images/art/house-cutaway.webp"
					width="1200"
					height="800"
					loading="lazy"
					decoding="async"
					alt="A cutaway drawing of a streamlined house of tomorrow: bedroom, study, kitchen and workshop, each with the same small valve machine, joined by coloured lines through the walls; a red arrow points to the one in the study."
					class="block h-auto w-full border-2 border-ink bg-paper-dark"
				/>
				<figcaption class="label mt-2 text-[13px] text-teal">
					Fig. 2 — Every room has its own small machine. None of them phones home.
				</figcaption>
			</figure>
		</section>
	</div>

	<!-- WRITE TO US, on teal -->
	<section id="write" class="bg-teal text-paper">
		<div class="mx-auto flex max-w-magazine flex-col gap-6 px-6 py-12 sm:flex-row sm:items-center sm:justify-between lg:py-14">
			<div>
				<h2 class="m-0 font-display text-[40px] font-black uppercase leading-none">Write to us</h2>
				<p class="mb-0 mt-3 text-[20px] leading-[1.55] text-paper" data-testid="write-line">
					Building something, or want to? The door is open.
				</p>
			</div>
			<a
				href={`mailto:${CONTACT_EMAIL}`}
				class={`${button} border-paper text-paper hover:bg-paper hover:text-teal`}
				data-track-type="email-cta"
				data-track-location="write-to-us"
				id="contact-email-btn"
			>
				{CONTACT_EMAIL}
			</a>
		</div>
	</section>
	</main>

	<Footer />
</Layout>
